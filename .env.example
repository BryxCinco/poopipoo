# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Map tiles (Phase 9): free CARTO key from https://carto.com/basemaps/apikey
# Public by design (it is in every tile URL). Without it, OpenStreetMap tiles are used.
NEXT_PUBLIC_CARTO_API_KEY=

# AI agent (Phase 8) — server only, never NEXT_PUBLIC_
GROQ_API_KEY=
# Hugging Face token with the "Make calls to Inference Providers" permission
HUGGINGFACE_API_KEY=

# Error monitoring (optional): https://sentry.io → project → Client Keys (DSN).
# Without a DSN, Sentry is off.
NEXT_PUBLIC_SENTRY_DSN=
# Build only (e.g. Vercel env): uploads source maps for readable stack traces
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Demo mode (Phase 15, optional): the demo account's user id, printed by
# `npx tsx scripts/create-demo-user.ts`. Server only. Without it, the
# "Try demo" button is hidden.
DEMO_USER_ID=
