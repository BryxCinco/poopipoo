# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API Keys.
# Uses the new key format (not the legacy anon / service_role JWTs).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) — safe for the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) — server only, bypasses RLS. Never expose or commit.
SUPABASE_SECRET_KEY=
